#!/sbin/openrc-run
# 自带的 sshd 服务，不依赖上游怎么打包 OpenRC 脚本。
# ★ 理由：ssh 是这台机器【唯一】的救命通道（没有串口），
#   它能不能起来不该取决于 Alpine 某个版本把 init 脚本拆进了哪个子包。

description="gaokun3 sshd"

depend() {
    need localmount
    after gk3-wifi
}

start() {
    # 主机密钥：rescue 镜像在构建时就生成好了（这样每次开机指纹不变，
    # 自动化脚本不会撞 host key 变更）。公开的 live 镜像不带密钥 —— 
    # 大家共用一把私钥等于没有加密，所以那种情况下这里现生成。
    if ! ls /etc/ssh/ssh_host_*_key >/dev/null 2>&1; then
        ebegin "生成 ssh 主机密钥（本镜像未预置）"
        ssh-keygen -A
        eend $?
    fi
    ebegin "启动 sshd"
    /usr/sbin/sshd
    eend $?
}

stop() {
    ebegin "停 sshd"
    start-stop-daemon --stop --quiet --exec /usr/sbin/sshd
    eend $?
}
