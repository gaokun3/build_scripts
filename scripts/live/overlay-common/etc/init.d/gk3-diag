#!/sbin/openrc-run
# 把启动诊断写回启动介质。
#
# ★ 为什么需要它：这台机器没有串口。救援系统一旦"起来了但网络没起来"，
#   就【一点信息都拿不到】—— 2026-08-23 上机时正是如此，只能靠人到跟前
#   看屏幕。所以救援系统必须自己把证据留在介质上，
#   下次进 Android 挂上就能读。
#
# 它是整个 default runlevel 里最后跑的（after *），这样能把前面所有服务的
# 结果一并记下来。写失败不影响任何东西。

description="把启动诊断写回启动介质"

depend() {
    after gk3-wifi gk3-sshd
}

start() {
    MEDIA=/media/gk3
    OUT=$MEDIA/gaokun3/diag
    ebegin "写启动诊断到 $OUT"

    # 介质是只读挂的（initramfs 那边就是 -o ro）。临时改成读写，写完改回去。
    mount -o remount,rw "$MEDIA" 2>/dev/null || {
        ewarn "介质挂不成读写，跳过（U 盘写保护？）"
        eend 0; return 0
    }
    mkdir -p "$OUT" 2>/dev/null

    {
        echo "=== 时间 / 内核 ==="; date; uname -a; cat /proc/cmdline
        echo; echo "=== OpenRC 各 runlevel 状态 ==="; rc-status --all 2>&1
        echo; echo "=== 挂载 ==="; mount
        echo; echo "=== 网络接口 ==="; ip -br addr 2>&1; ip route 2>&1
        echo; echo "=== 无线 ==="; iw dev 2>&1 | head -20; iw dev wlan0 link 2>&1
        echo; echo "=== wpa_supplicant 配置来源 ==="
        for f in /media/gk3/gaokun3/wpa_supplicant.conf /etc/wpa_supplicant/wpa_supplicant.conf; do
            [ -f "$f" ] && echo "  有: $f" || echo "  无: $f"
        done
        echo; echo "=== 显示输出（DRM）==="
        for c in /sys/class/drm/card*-*; do
            [ -e "$c/status" ] || continue
            echo "  $(basename "$c"): $(cat "$c/status" 2>/dev/null)"
            [ -f "$c/modes" ] && sed "s/^/    mode /" "$c/modes" 2>/dev/null | head -4
        done
        echo "=== 输入设备（触摸/键盘）==="; cat /proc/bus/input/devices 2>/dev/null | grep -E "^N:|^H:" | head -20
        echo; echo "=== 安装器日志 ==="; tail -30 /var/log/gk3-installer.log 2>/dev/null
        echo; echo "=== 进程 ==="; ps -o pid,args 2>&1 | head -40
        echo; echo "=== sshd 生效配置 ==="; /usr/sbin/sshd -T 2>&1 | grep -iE "^(port|permitrootlogin|pubkeyauth|passwordauth|authorizedkeysfile|usepam|strictmodes)" 
        echo; echo "=== root 账户 ==="; getent passwd root; grep '^root:' /etc/shadow
        echo; echo "=== authorized_keys ==="; ls -la /root/.ssh/ 2>&1; wc -c /root/.ssh/authorized_keys 2>&1
        echo; echo "=== ath11k / 固件 ==="; dmesg 2>/dev/null | grep -iE "ath11k|firmware" | tail -20
        echo; echo "=== dmesg 尾部 ==="; dmesg 2>/dev/null | tail -40
        echo; echo "=== 系统日志 ==="; tail -60 /var/log/messages 2>/dev/null
    } > "$OUT/boot-$(date +%Y%m%d-%H%M%S).log" 2>&1

    sync
    mount -o remount,ro "$MEDIA" 2>/dev/null
    eend 0
}
