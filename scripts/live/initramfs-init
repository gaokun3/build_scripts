#!/bin/sh
# gaokun3 live/rescue initramfs.
#
# 一份 init 同时服务两种介质：
#   * U 盘（LiveCD）：squashfs 就在那个 FAT 分区上
#   * 内置盘（救援系统）：squashfs 在自己的小分区上
# 所以【不靠分区标签、不靠 UUID】—— 挨个挂上去找那个文件。
# 配置越少，越不会因为"换了台机器"而失效。
#
# cmdline 参数：
#   gk3.squash=<路径>   squashfs 在介质上的路径（默认 /gaokun3/rescue.squashfs）
#   gk3.dev=<设备>      跳过搜索，直接用这个块设备
#   gk3.debug           出错时给一个 shell，而不是重启
#
# ⚠️ 失败时【默认重启】而不是停在 shell：这台机器没有串口，停住就等于要人到
#    机器旁按电源键。重启会回到 systemd-boot 菜单 → 15 秒 → default(Android)，
#    也就是回到一个能远程接入的系统。

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

SQUASH=/gaokun3/rescue.squashfs
FORCE_DEV=
DEBUG=

say()  { echo "[gk3] $*"; }
fail() {
    echo
    echo "================ gaokun3 rescue: 起不来 ================"
    echo "原因: $*"
    echo
    echo "已知的块设备:"
    ls /sys/class/block 2>/dev/null | tr '\n' ' '; echo
    echo "cmdline: $(cat /proc/cmdline 2>/dev/null)"
    echo "======================================================="
    if [ -n "$DEBUG" ]; then
        echo "gk3.debug 已给 —— 进 shell。exit 之后会重启。"
        sh
    else
        echo "60 秒后重启（回到启动菜单；加 gk3.debug 可以停在这里）"
        sleep 60
    fi
    reboot -f
    # reboot -f 万一没生效
    while : ; do sleep 60; done
}

mkdir -p /proc /sys /dev /mnt /lower /upper /newroot
mount -t proc     proc     /proc  || fail "挂 /proc 失败"
mount -t sysfs    sysfs    /sys   || fail "挂 /sys 失败"
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev

for arg in $(cat /proc/cmdline); do
    case "$arg" in
        gk3.squash=*) SQUASH="${arg#gk3.squash=}" ;;
        gk3.dev=*)    FORCE_DEV="${arg#gk3.dev=}" ;;
        gk3.debug)    DEBUG=1 ;;
    esac
done

# devtmpfs 已经把节点建好了；没有的话用 mdev 兜底
[ -e /dev/null ] || /bin/busybox mdev -s

say "找 $SQUASH"

MEDIA=
try_dev() {
    d=$1
    [ -b "$d" ] || return 1
    mount -o ro "$d" /mnt 2>/dev/null || return 1
    if [ -f "/mnt$SQUASH" ]; then
        say "找到了：$d"
        MEDIA=$d
        return 0
    fi
    umount /mnt 2>/dev/null
    return 1
}

if [ -n "$FORCE_DEV" ]; then
    try_dev "$FORCE_DEV" || fail "gk3.dev=$FORCE_DEV 上没有 $SQUASH"
else
    # ★ 先试可移动介质（U 盘），再试内置盘。
    #   理由：插着 LiveCD 启动时，用户想要的是【U 盘上那一份】，
    #   而不是内置盘上可能很旧的那一份。
    for pass in removable fixed; do
        [ -n "$MEDIA" ] && break
        for sysdev in /sys/class/block/*; do
            name=$(basename "$sysdev")
            case "$name" in
                loop*|ram*|dm-*|zram*) continue ;;
            esac
            # 只看分区（有 partition 属性的），整盘跳过
            [ -f "$sysdev/partition" ] || continue
            parent=$(basename "$(dirname "$(readlink -f "$sysdev")")")
            rm_flag=$(cat "/sys/class/block/$parent/removable" 2>/dev/null || echo 0)
            case "$pass" in
                removable) [ "$rm_flag" = "1" ] || continue ;;
                fixed)     [ "$rm_flag" = "1" ] && continue ;;
            esac
            try_dev "/dev/$name" && break
        done
    done
fi

[ -n "$MEDIA" ] || fail "所有分区上都没有 $SQUASH"

mount -o ro,loop "/mnt$SQUASH" /lower || fail "挂 squashfs 失败（内核缺 CONFIG_SQUASHFS？）"

# 整个系统跑在内存里：改动落在 tmpfs，介质保持只读。
# ⚠️ 这台机器 15.7 GiB 内存，50% 上限足够，而且留了一半给安装过程用。
mount -t tmpfs -o size=50%,mode=0755 tmpfs /upper || fail "挂 tmpfs 失败"
mkdir -p /upper/rw /upper/work
mount -t overlay overlay \
      -o lowerdir=/lower,upperdir=/upper/rw,workdir=/upper/work /newroot \
      || fail "挂 overlayfs 失败（内核缺 CONFIG_OVERLAY_FS？）"

# 把介质本身也带进去：安装器要从 U 盘上读 super.img / boot.img
mkdir -p /newroot/media/gk3
mount --move /mnt /newroot/media/gk3 2>/dev/null || say "警告：介质没能移进新根"

mkdir -p /newroot/proc /newroot/sys /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys  /newroot/sys
mount --move /dev  /newroot/dev

[ -x /newroot/sbin/init ] || fail "新根里没有 /sbin/init"
say "switch_root"
exec switch_root /newroot /sbin/init
fail "switch_root 没成功"
