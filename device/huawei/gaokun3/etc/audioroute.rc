# 开机应用扬声器混音器路由（Android 无 ALSA UCM，见 bin/audio-route.sh）。
# 声卡注册在 ADSP 的 GPR 服务就绪之后，所以脚本自己等 /dev/snd/controlC0。
service audioroute /vendor/bin/audio-route.sh
    user root
    group root audio
    # ⚠️ 这里【曾经】是 `seclabel u:r:shell:s0` —— 让一个 root 守护进程跑在
    #    为 adb 设计的 shell 域里，方向是反的，转 enforcing 也过不了。
    #    现在由 sepolicy/file_contexts 给可执行文件打标签，init 自动做域转换
    #    （sepolicy/gaokun3_scripts.te）。
    oneshot
    disabled

on property:sys.boot_completed=1
    start audioroute
